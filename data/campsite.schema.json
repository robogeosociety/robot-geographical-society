{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Campsite",
  "description": "A simplified schema for campsite data with focus on availability windows.",
  "type": "object",
  "required": [
    "name",
    "agency",
    "lat",
    "lng",
    "reservation_url",
    "availability_windows"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "agency": {
      "type": "string"
    },
    "agency_short": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "pattern": "^WA$"
    },
    "lat": {
      "type": "number",
      "minimum": 45.0,
      "maximum": 49.5
    },
    "lng": {
      "type": "number",
      "minimum": -125.0,
      "maximum": -116.0
    },
    "sites": {
      "type": "integer",
      "minimum": 0
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["tent", "rv", "walk-in", "cabin", "bike-in", "parking", "boat-in", "group"]
      }
    },
    "reservable": {
      "type": "boolean"
    },
    "reservation_url": {
      "type": "string",
      "format": "uri"
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "availability_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
          "end": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
          "booking_advance_days": { "type": "integer" },
          "site_total_count": { "type": "integer", "minimum": 0 },
          "reserved_count": { "type": "integer", "minimum": 0 }
        },
        "required": ["start", "end"]
      }
    },
    "rec_gov_id": {
      "type": ["string", "null"],
      "pattern": "^\\d+$"
    },
    "resource_location_id": {
      "type": ["integer", "null"]
    },
    "quality_score": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
    }
  }
}
