# Manage the Cloudflare Access boundary for the backend Worker.
#
# Auth is the *vended* rgs-access-admin token, read from the cloudflare-tfvend repo's
# Terraform output (offline — no bootstrap token needed). Override its path with
# TFVEND=/path if the repo lives elsewhere.

TFVEND ?= /Volumes/dev/cloudflare-tfvend
ENVFILE ?= ../../web/.env.local
export CLOUDFLARE_API_TOKEN := $(shell terraform -chdir=$(TFVEND) output -raw rgs_access_admin_token 2>/dev/null)
# Remote-state (R2 S3 backend) credentials — the vended tfstate-r2 token.
export AWS_ACCESS_KEY_ID := $(shell terraform -chdir=$(TFVEND) output -raw tfstate_r2_access_key_id 2>/dev/null)
export AWS_SECRET_ACCESS_KEY := $(shell terraform -chdir=$(TFVEND) output -raw tfstate_r2_secret_access_key 2>/dev/null)

.PHONY: help check init migrate plan apply envfile destroy

init: check
	terraform init

# One-time migration of existing local state into the R2 backend.
migrate: check
	terraform init -migrate-state

help:
	@echo "make plan      # terraform plan"
	@echo "make apply     # terraform apply (auto-approve) — creates the Access app + service token"
	@echo "make envfile   # write $(ENVFILE) (BACKEND_URL + service token) for local dev"

check:
	@test -n "$(CLOUDFLARE_API_TOKEN)" || { \
		echo "No vended token. Is $(TFVEND) applied? (terraform -chdir=$(TFVEND) output rgs_access_admin_token)"; exit 1; }

plan: check
	terraform plan

apply: check
	terraform apply -auto-approve

# Write web/.env.local from the Terraform outputs (service token never echoed).
envfile: check
	@{ \
		echo "# Generated by infra/access (terraform output) — gitignored. Do not commit."; \
		echo "BACKEND_URL=$$(terraform output -raw backend_url)"; \
		echo "CF_ACCESS_CLIENT_ID=$$(terraform output -raw service_token_client_id)"; \
		echo "CF_ACCESS_CLIENT_SECRET=$$(terraform output -raw service_token_client_secret)"; \
	} > $(ENVFILE) && echo "Wrote $(ENVFILE)."

destroy: check
	terraform destroy
